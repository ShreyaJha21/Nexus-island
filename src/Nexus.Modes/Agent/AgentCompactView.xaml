<UserControl x:Class="Nexus.Modes.Agent.AgentCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls"
             Height="32" Padding="12,0">
    <!-- Figma: Island / Compact, Agent working (4:73), needs you (4:81), done (4:88);
         Agent · Failed (18:231); Agent · 3 sessions (18:237) -->
    <StackPanel Orientation="Horizontal">
        <c:NexusIcon Kind="{Binding CompactIcon}" Foreground="{Binding CompactIconBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CompactTitle}" Style="{StaticResource Text.BodyStrong}" MaxWidth="200" Margin="8,0,0,0" />
        <TextBlock Text="{Binding CompactCaption}" MaxWidth="220" Margin="8,0,0,0"
                   Visibility="{Binding ShowCompactCaption, Converter={StaticResource BoolToVisibility}}">
            <TextBlock.Style>
                <!-- Working uses Body secondary, other states use Caption, as in the design. -->
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorking}" Value="True">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="LineHeight" Value="20" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Border Style="{StaticResource Chip}" Margin="8,0,0,0"
                Visibility="{Binding ShowNeedsYouChip, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding NeedsYouChip}" Style="{StaticResource Text.Caption}" Foreground="{Binding AttentionTextBrush}" />
        </Border>
    </StackPanel>
</UserControl>
