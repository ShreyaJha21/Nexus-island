<UserControl x:Class="Nexus.Modes.Agent.AgentPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls"
             Width="360" Padding="16">
    <Grid>
        <!-- Figma: Island / Panel, Mode=Agent needs you (7:79) -->
        <StackPanel Visibility="{Binding ShowNeedsYouPanel, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <c:NexusIcon Kind="attention" Width="20" Height="20" Foreground="{StaticResource Brush.Attention}" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding NeedsYouAge}" Style="{StaticResource Text.Caption}" DockPanel.Dock="Right" />
                <TextBlock Text="{Binding NeedsYouTitle}" Style="{StaticResource Text.BodyStrong}" Margin="8,0,8,0" />
            </DockPanel>

            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="{Binding NeedsYouContext}" Style="{StaticResource Text.Caption}" />
                <Border Margin="0,6,0,0" Padding="10,8" CornerRadius="4" Background="{StaticResource Brush.Subtle}"
                        BorderBrush="{StaticResource Brush.StrokeSurface}" BorderThickness="1"
                        Visibility="{Binding HasPendingCommand, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding PendingCommand}" FontFamily="{StaticResource Font.Mono}" FontSize="13" LineHeight="20"
                               Foreground="{StaticResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding PendingCommand}" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Open terminal" Command="{Binding OpenTerminalCommand}" Style="{StaticResource Button.Primary}" />
                <Button Content="Remind me later" Command="{Binding RemindLaterCommand}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock Text="Nexus only shows status. Approve or deny in your terminal." Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="{Binding OtherSessionsText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                       Visibility="{Binding IsMulti, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Figma: Panel · Agent sessions (18:254) -->
        <StackPanel Visibility="{Binding ShowSessionsPanel, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <c:NexusIcon Kind="bot" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Text="{Binding PanelHeader}" Style="{StaticResource Text.BodyStrong}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding PanelCount}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
            </StackPanel>

            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Focusable="False">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Row}" Margin="0,0,0,8"
                                    Command="{Binding DataContext.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="Open terminal"
                                    AutomationProperties.Name="{Binding Project}">
                                <DockPanel>
                                    <c:NexusIcon Kind="{Binding Icon}" Foreground="{Binding IconBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Time}" Style="{StaticResource Text.Caption}" />
                                        <Button Style="{StaticResource Button.Link}" Content="Dismiss" Margin="8,0,0,0"
                                                Visibility="{Binding CanDismiss, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <StackPanel Margin="10,0,8,0">
                                        <TextBlock Text="{Binding Project}" Style="{StaticResource Text.BodyStrong}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Foreground="{Binding DetailBrush}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="Shows the tool and file name only, never file contents or prompts." Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
