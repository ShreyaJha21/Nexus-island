<UserControl x:Class="Nexus.Modes.Call.CallBubbleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls">
    <!-- 32 px detached bubble: the call's state icon, when something more urgent holds the island -->
    <c:NexusIcon Kind="{Binding CompactIcon}" Foreground="{Binding CompactIconBrush}" />
</UserControl>
