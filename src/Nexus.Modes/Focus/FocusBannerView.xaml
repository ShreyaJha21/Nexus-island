<UserControl x:Class="Nexus.Modes.Focus.FocusBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls"
             Height="56" Padding="12,0">
    <!-- Figma: Focus · Session complete (18:345) -->
    <StackPanel Orientation="Horizontal">
        <c:NexusIcon Kind="check" Width="20" Height="20" Foreground="{StaticResource Brush.Success}" VerticalAlignment="Center" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Focus session done" Style="{StaticResource Text.BodyStrong}" />
            <TextBlock Text="{Binding DoneSubtitle}" Style="{StaticResource Text.Caption}" />
        </StackPanel>
        <Button Content="Start break" Command="{Binding StartBreakCommand}" Style="{StaticResource Button.Primary}"
                Margin="12,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
