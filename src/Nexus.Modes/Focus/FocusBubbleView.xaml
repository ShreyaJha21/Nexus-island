<UserControl x:Class="Nexus.Modes.Focus.FocusBubbleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls">
    <!-- 32 px detached bubble: the ring alone, when something more urgent holds the island -->
    <Grid>
        <c:Ring Progress="{Binding Progress}" Brush="{DynamicResource Brush.Accent}"
                Visibility="{Binding IsBreak, Converter={StaticResource InverseBoolToVisibility}}" />
        <c:Ring Progress="{Binding Progress}" Brush="{StaticResource Brush.Success}"
                Visibility="{Binding IsBreak, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
