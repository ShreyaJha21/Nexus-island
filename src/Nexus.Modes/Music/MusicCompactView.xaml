<UserControl x:Class="Nexus.Modes.Music.MusicCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls"
             Height="32" Padding="12,0,4,0">
    <!-- Figma: Island / Compact, Mode=Music (4:94), plus back / play-pause / next right on the pill.
         The level meter takes the playing service's brand colour (YouTube red, Spotify green). -->
    <StackPanel Orientation="Horizontal">
        <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Brush.ArtPlaceholder}" VerticalAlignment="Center">
            <Border CornerRadius="4" Visibility="{Binding HasArt, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding AlbumArt}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Border>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyStrong}" MaxWidth="180" Margin="8,0,0,0"
                   ToolTip="{Binding Title}" />
        <TextBlock Text="{Binding Artist}" Style="{StaticResource Text.Caption}" MaxWidth="110" Margin="8,0,0,0"
                   Visibility="{Binding HasArtist, Converter={StaticResource BoolToVisibility}}" />
        <c:LevelMeter IsActive="{Binding IsPlaying}" BarBrush="{Binding BrandBrush}" Margin="8,0,4,0"
                      ToolTip="{Binding SourceText}" />

        <Button Style="{StaticResource Button.IslandIcon}" Command="{Binding PreviousCommand}" Margin="2,0,0,0"
                ToolTip="Previous" AutomationProperties.Name="Previous track">
            <c:NexusIcon Kind="previous" Width="14" Height="14" />
        </Button>
        <Button Style="{StaticResource Button.IslandIcon}" Command="{Binding PlayPauseCommand}"
                ToolTip="{Binding PlayPauseLabel}" AutomationProperties.Name="{Binding PlayPauseLabel}">
            <c:NexusIcon Kind="{Binding PlayPauseIcon}" Width="14" Height="14" />
        </Button>
        <Button Style="{StaticResource Button.IslandIcon}" Command="{Binding NextCommand}"
                ToolTip="Next" AutomationProperties.Name="Next track">
            <c:NexusIcon Kind="next" Width="14" Height="14" />
        </Button>
    </StackPanel>
</UserControl>
