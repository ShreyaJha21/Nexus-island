<UserControl x:Class="Nexus.Modes.Shelf.ShelfCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls"
             Height="32" Padding="8,0,12,0"
             c:IslandInput.OwnsDrag="True" Background="Transparent" Cursor="Hand"
             AutomationProperties.Name="Shelf: drag into any app"
             ToolTip="Drag into any app to drop everything here · click to pick one">
    <!-- The shelf pill: the newest items stacked like cards, and how many there are.
         Dragging the pill drops all of them; click to open the shelf and pick one. -->
    <StackPanel Orientation="Horizontal">
        <ItemsControl ItemsSource="{Binding Front}" VerticalAlignment="Center" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Overlapping by 8 px, each with a ring in the island's colour so the edges read. -->
                    <Border Width="22" Height="22" CornerRadius="5" Margin="0,0,-8,0" BorderThickness="1.5"
                            BorderBrush="{StaticResource Brush.IslandOpaque}" Background="{StaticResource Brush.Subtle}">
                        <Grid>
                            <Border CornerRadius="4" Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <c:NexusIcon Kind="note" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.BodyStrong}" Margin="16,0,0,0" />
        <TextBlock Text="drag anywhere" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
    </StackPanel>
</UserControl>
