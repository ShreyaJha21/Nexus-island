<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Nexus.Modes.Controls">

    <!--
      Nexus tokens. Every value aliases a Fluent 2 semantic token (dark), as listed in the
      PRD's design language section and the Figma variables. Accent brushes are replaced at
      runtime with the Windows accent color when "UseSystemAccent" is on, so views reference
      them with DynamicResource.
    -->

    <!-- Type: Segoe UI Variable, Fluent 2 ramp -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <!-- Colors -->
    <Color x:Key="Color.TextPrimary">#FFFFFFFF</Color>
    <Color x:Key="Color.TextSecondary">#FFADADAD</Color>
    <!-- Figma: #141414 at 92% over a 60 px acrylic blur. A transparent WPF window cannot blur what is
         behind it, so the fill is raised to 97% to keep text at 4.5:1 over busy content. -->
    <Color x:Key="Color.Island">#F7141414</Color>
    <Color x:Key="Color.Solid">#FF1F1F1F</Color>
    <Color x:Key="Color.Subtle">#FF333333</Color>
    <Color x:Key="Color.SubtleHover">#FF3D3D3D</Color>
    <Color x:Key="Color.Control">#FF292929</Color>
    <Color x:Key="Color.StrokeSurface">#FF3D3D3D</Color>
    <Color x:Key="Color.StrokeControl">#FF666666</Color>
    <Color x:Key="Color.Accent">#FF479EF5</Color>
    <Color x:Key="Color.AccentFill">#FF115EA3</Color>
    <Color x:Key="Color.Attention">#FFF98845</Color>
    <Color x:Key="Color.Critical">#FFDC626D</Color>
    <Color x:Key="Color.Success">#FF54B054</Color>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Island" Color="{StaticResource Color.Island}" />
    <SolidColorBrush x:Key="Brush.Solid" Color="{StaticResource Color.Solid}" />
    <SolidColorBrush x:Key="Brush.Subtle" Color="{StaticResource Color.Subtle}" />
    <SolidColorBrush x:Key="Brush.SubtleHover" Color="{StaticResource Color.SubtleHover}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Subtle}" />
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}" />
    <SolidColorBrush x:Key="Brush.StrokeSurface" Color="{StaticResource Color.StrokeSurface}" />
    <SolidColorBrush x:Key="Brush.StrokeControl" Color="{StaticResource Color.StrokeControl}" />
    <!-- The island's edge over a blurred backdrop: white at ~12%, like Windows 11 flyouts. -->
    <SolidColorBrush x:Key="Brush.StrokeAcrylic" Color="#1FFFFFFF" />
    <!-- Surfaces that have no blur behind them (the detached bubble) stay nearly opaque. -->
    <SolidColorBrush x:Key="Brush.IslandOpaque" Color="#F7141414" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentFill" Color="{StaticResource Color.AccentFill}" />
    <SolidColorBrush x:Key="Brush.AccentFillHover" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="Brush.AccentFillPressed" Color="#FF0C3B5E" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Attention" Color="{StaticResource Color.Attention}" />
    <!-- Claude's brand colour: Claude Code's working and "needs you" states. -->
    <SolidColorBrush x:Key="Brush.Claude" Color="#FFD97757" />
    <SolidColorBrush x:Key="Brush.Critical" Color="{StaticResource Color.Critical}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />

    <!-- Album art placeholder from the design -->
    <LinearGradientBrush x:Key="Brush.ArtPlaceholder" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFFA8C59" Offset="0" />
        <GradientStop Color="#FF8C40BF" Offset="1" />
    </LinearGradientBrush>

    <CornerRadius x:Key="Radius.Overlay">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- Text styles (Fluent 2 ramp). Live numbers use tabular figures so the island does not jitter. -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="Text.BodySecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Keyboard focus: Fluent's 2 px ring -->
    <Style x:Key="FocusVisual.Fluent">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource Brush.TextPrimary}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fluent Button, medium: 32 px tall, 4 px corners, min width 96 -->
    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Fluent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.AccentFill}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentFillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentFillPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Claude Code's primary action, in Claude's colour. Deeper than Brush.Claude so white text keeps
         about 5:1 contrast. -->
    <Style x:Key="Button.Claude" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="#FFB05430" />
        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFBE5D37" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF96462A" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Control}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.StrokeControl}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SubtleHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Solid}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 32 px square icon button (subtle) -->
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Subtle}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.Control}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.IconPrimary" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="Width" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Round call buttons (Figma: Island / Call). 32 px by default; 24 px on the pill, 44 px in the panel.
         A white wash on hover keeps the colour recognisable. -->
    <Style x:Key="Button.Round" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#FF3D3D3D" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Fluent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="100" Background="{TemplateBinding Background}" />
                        <Border x:Name="Wash" CornerRadius="100" Background="#26FFFFFF" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Wash" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.RoundSubtle" TargetType="Button" BasedOn="{StaticResource Button.Round}" />
    <!-- Fluent's danger and success fills: white icons stay above 4.5:1 on both. -->
    <Style x:Key="Button.Decline" TargetType="Button" BasedOn="{StaticResource Button.Round}">
        <Setter Property="Background" Value="#FFC50F1F" />
    </Style>
    <Style x:Key="Button.Accept" TargetType="Button" BasedOn="{StaticResource Button.Round}">
        <Setter Property="Background" Value="#FF0F7B0F" />
    </Style>

    <!-- 24 px subtle icon button inside the compact island (music controls); Fluent 4 px control radius -->
    <Style x:Key="Button.IslandIcon" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Fluent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Launcher quick-action tile -->
    <Style x:Key="Button.Tile" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="{StaticResource Brush.Subtle}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush.SubtleHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A list row that behaves like a button (agent sessions) -->
    <Style x:Key="Button.Row" TargetType="Button" BasedOn="{StaticResource Button.Tile}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Text link, e.g. "Set up" -->
    <Style x:Key="Button.Link" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Fluent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Label" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}" LineHeight="16" VerticalAlignment="Center" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small chip, e.g. "+2" or "1 needs you" -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Subtle}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Thin progress bar: 4 px, 2 px corners -->
    <Style x:Key="Progress.Thin" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right-click menu (Figma: Menu / Island right-click) -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="12,4,12,20" Width="260" Padding="4" CornerRadius="8"
                            Background="{StaticResource Brush.Solid}" BorderBrush="{StaticResource Brush.StrokeSurface}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="14" Direction="270" Opacity="0.3" Color="Black" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,2" Background="{StaticResource Brush.StrokeSurface}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus look up separators by this key, not by type. -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}" />

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Margin="0,1" Padding="10,6" CornerRadius="4" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" Style="{StaticResource Text.Body}"
                                       Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Style="{StaticResource Text.Caption}"
                                       Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Subtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Padding="8,5" CornerRadius="4" Background="{StaticResource Brush.Solid}"
                            BorderBrush="{StaticResource Brush.StrokeSurface}" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Brush.TextPrimary}" TextWrapping="Wrap" MaxWidth="280" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
