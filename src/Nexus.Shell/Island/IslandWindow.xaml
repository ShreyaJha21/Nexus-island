<Window x:Class="Nexus.Shell.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Nexus.Modes.Controls;assembly=Nexus.Modes"
        xmlns:local="clr-namespace:Nexus.Shell.Island"
        Title="Nexus" Width="460" Height="58"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Focusable="True"
        FontFamily="{StaticResource Font.Text}" TextOptions.TextFormattingMode="Display">

    <!--
      The window is a transparent canvas fixed above the taskbar. Fully transparent pixels let
      clicks through, so only the island itself is interactive. The island grows upward from
      the bottom edge (or downward when placed top-center).
    -->
    <Grid x:Name="Root">
        <Grid x:Name="Stage" VerticalAlignment="Bottom" Margin="0,0,0,8" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="StageShift" Y="8" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Hit area: gives the 6 px resting line a comfortable hover target. -->
            <Border x:Name="HitArea" Grid.Column="1" VerticalAlignment="Bottom" Background="Transparent">
                <Grid x:Name="Surface" Width="64" Height="6" VerticalAlignment="Bottom"
                      AutomationProperties.Name="Nexus island" AutomationProperties.LiveSetting="Polite">
                    <local:SoftShadow x:Name="Shadow" Blur="8" OffsetY="4" Strength="0.28" Radius="3" />
                    <Border x:Name="SurfaceFill" CornerRadius="3" Background="{DynamicResource Brush.Island}"
                            BorderBrush="{StaticResource Brush.StrokeSurface}" BorderThickness="0" />

                    <Grid x:Name="ContentClip">
                        <c:AnchorPanel x:Name="OutgoingHost" IsHitTestVisible="False" />
                        <c:AnchorPanel x:Name="CurrentHost" />
                    </Grid>

                    <Border x:Name="AttentionEdge" CornerRadius="8" BorderThickness="1.5" Opacity="0"
                            BorderBrush="{StaticResource Brush.Attention}" IsHitTestVisible="False" />

                    <!-- The signature "needs you" pulse: one ring that eases outward and fades. No effects,
                         so it stays cheap in software rendering. -->
                    <Border x:Name="PulseRing" CornerRadius="10" BorderThickness="2" Margin="-2" Opacity="0"
                            BorderBrush="{StaticResource Brush.Attention}" IsHitTestVisible="False"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="PulseScale" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <!-- 32 px detached bubble for the second activity -->
            <Grid x:Name="Bubble" Grid.Column="2" Width="32" Height="32" Margin="8,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0" Visibility="Collapsed"
                  Cursor="Hand" AutomationProperties.Name="Next activity">
                <local:SoftShadow Blur="8" OffsetY="4" Strength="0.28" Radius="8" />
                <Border CornerRadius="8" Background="{DynamicResource Brush.Island}"
                        BorderBrush="{StaticResource Brush.StrokeSurface}" BorderThickness="1">
                    <ContentPresenter x:Name="BubbleContent" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
