<UserControl x:Class="Nexus.Shell.Views.DropTargetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls;assembly=Nexus.Modes"
             Width="360" Padding="12" AllowDrop="True">
    <!-- Shown while something is dragged over the island: a big, obvious place to let go. -->
    <Grid Height="96">
        <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.5" StrokeDashArray="4 3"
                   Stroke="{DynamicResource Brush.Accent}" Fill="#14FFFFFF" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:NexusIcon Kind="add" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" />
            <TextBlock Text="Drop to keep it here" Style="{StaticResource Text.BodyStrong}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            <TextBlock x:Name="Hint" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                       Text="Stays on the island for an hour · then drag it into any app" />
        </StackPanel>
    </Grid>
</UserControl>
