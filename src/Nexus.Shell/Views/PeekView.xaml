<UserControl x:Class="Nexus.Shell.Views.PeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32" Padding="12,0">
    <!-- Figma: Island / Idle, State=Hover peek · nothing scheduled (15:114) -->
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding PeekTime}" Style="{StaticResource Text.BodyStrong}" />
        <TextBlock Text="{Binding PeekDate}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding PeekStatus}" Style="{StaticResource Text.BodySecondary}" Margin="8,0,0,0" />
    </StackPanel>
</UserControl>
