<UserControl x:Class="Nexus.Shell.Views.ToastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Nexus.Modes.Controls;assembly=Nexus.Modes"
             Height="32" Padding="12,0">
    <!-- Figma: Hidden by shortcut · Toast (18:317) -->
    <StackPanel Orientation="Horizontal">
        <c:NexusIcon Kind="eyeOff" VerticalAlignment="Center" />
        <TextBlock Text="Nexus hidden" Style="{StaticResource Text.BodyStrong}" Margin="8,0,0,0" />
        <TextBlock x:Name="Hint" Text="Ctrl+Alt+Space to show" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
    </StackPanel>
</UserControl>
